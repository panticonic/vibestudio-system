{
  "name": "@workspace-apps/terminal-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "vibestudio": {
    "displayName": "Vibestudio Terminal",
    "icon": "./assets/icon.svg",
    "app": {
      "target": "terminal",
      "entry": "src/index.ts"
    },
    "authority": {
      "provides": [],
      "requests": [
        {
          "capability": "approvals.decide",
          "resource": {
            "kind": "prefix",
            "prefix": ""
          },
          "tier": "gated",
          "evidence": "intentional-broad"
        },
        {
          "capability": "approvals.read",
          "resource": {
            "kind": "prefix",
            "prefix": ""
          },
          "tier": "gated",
          "evidence": "intentional-broad"
        },
        {
          "capability": "context.boundary",
          "resource": {
            "kind": "prefix",
            "prefix": "context"
          },
          "tier": "critical",
          "evidence": "bounded-dynamic"
        },
        {
          "capability": "context.materialize",
          "resource": {
            "kind": "prefix",
            "prefix": ""
          },
          "tier": "gated",
          "evidence": "intentional-broad"
        },
        {
          "capability": "protected-input.submit",
          "resource": {
            "kind": "prefix",
            "prefix": ""
          },
          "tier": "gated",
          "evidence": "intentional-broad"
        },
        {
          "capability": "workspace.configure",
          "resource": {
            "kind": "prefix",
            "prefix": ""
          },
          "tier": "gated",
          "evidence": "intentional-broad"
        }
      ]
    },
    "description": "Browse and run terminal apps, resume sessions and answer approvals from any terminal."
  },
  "dependencies": {
    "@vibestudio/rpc": "workspace:*",
    "@vibestudio/service-schemas": "workspace:*",
    "@vibestudio/shared": "workspace:*",
    "@vibestudio/shell-core": "workspace:*",
    "@workspace-workers/terminal-sessions": "workspace:*",
    "@workspace/terminal-host-protocol": "workspace:*",
    "@xterm/headless": "^5.5.0",
    "ink": "^6.8.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@workspace/terminal-shim": "workspace:*",
    "vitest": "^3.2.7"
  }
}
